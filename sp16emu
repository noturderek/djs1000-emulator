#!/usr/bin/env python3
"""sp16emu: build, run and manage the SP16 Emulator. All the work is in emulator/sp16emu.py; run `./sp16emu help`."""
import os
import sys

if sys.version_info < (3, 9):
    sys.exit("sp16emu: needs Python 3.9 or later; install the Xcode Command Line Tools (xcode-select --install)")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "emulator"))
import sp16emu  # noqa: E402

sys.exit(sp16emu.main())
