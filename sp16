#!/usr/bin/env python3
"""sp16: build, run and manage the SP16 Emulator. All the work is in emulator/sp16emu.py; run `./sp16 help`."""
import os
import sys

if sys.version_info < (3, 9):
    sys.exit("sp16: needs Python 3.9 or later; install the Xcode Command Line Tools (xcode-select --install)")
REPOSITORY_ROOT = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(REPOSITORY_ROOT, "emulator"))
import sp16emu  # noqa: E402

sys.exit(sp16emu.main())
